<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BoneCheats</AssemblyName>
    <RootNamespace>BoneCheats</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <!-- Optional per-machine override: copy BoneCheats.props.user.example to BoneCheats.props.user -->
  <Import Project="BoneCheats.props.user" Condition="Exists('BoneCheats.props.user')" />

  <PropertyGroup>
    <BonelabDir Condition="'$(BonelabDir)' == '' And '$(BONELAB_DIR)' != ''">$(BONELAB_DIR)</BonelabDir>
    <BonelabDir Condition="'$(BonelabDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BONELAB</BonelabDir>
  </PropertyGroup>

  <!-- <Private>False</Private> on every reference below: none of these ship with the mod, they're already
       sitting in the game/MelonLoader folders on every machine that can load it, so copying them into our own
       output would just be dead weight (and the actual reason only BoneCheats.dll comes out of a build). -->
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(BonelabDir)\MelonLoader\net6\MelonLoader.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BonelabDir)\MelonLoader\net6\0Harmony.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BonelabDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="LabFusion"><HintPath>$(BonelabDir)\Mods\LabFusion.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="BoneLib"><HintPath>$(BonelabDir)\Mods\BoneLib.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(BonelabDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(BonelabDir)\MelonLoader\Il2CppAssemblies\UnityEngine.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <!--
    BONELAB's own types (RigManager, Gun, AmmoInventory, PhysicsRig, ...) are compiled against for real now.
    They live in Il2CppSLZ.Marrow.dll, whose signatures in turn mention types from the other generated
    assemblies (Il2CppUniTask, Unity.*, Il2CppSystem, ...), so the compiler needs those too. Wildcards pick
    up everything MelonLoader generated; unused ones cost nothing.
  -->
  <ItemGroup>
    <Reference Include="$(BonelabDir)\MelonLoader\Il2CppAssemblies\Il2Cpp*.dll"><Private>False</Private></Reference>
    <Reference Include="$(BonelabDir)\MelonLoader\Il2CppAssemblies\Unity.*.dll"><Private>False</Private></Reference>
    <Reference Include="$(BonelabDir)\MelonLoader\Il2CppAssemblies\UnityEngine.*.dll"><Private>False</Private></Reference>
  </ItemGroup>

  <!-- Copies the built DLL straight into Mods -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="Exists('$(BonelabDir)\Mods')">
    <Copy SourceFiles="$(OutputPath)BoneCheats.dll" DestinationFolder="$(BonelabDir)\Mods" />
  </Target>
</Project>
